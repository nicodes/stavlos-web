---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				stavlos
			</a>
			<nav aria-label="Main">
				<a href="#team">Working model</a>
				<a href="https://github.com/nicodes/stavlos#readme">Get started ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="workshop-cover">
				<div class="workshop-title">
					<p class="tag">A LOCAL WORKSHOP FOR CODING AGENTS</p>
					<h1>
						Keep the team.
						<br />
						<em>Keep the thread.</em>
					</h1>
					<p>
						Persistent agents, shared channels and work you can steer. Give a task room to grow beyond a single turn.
					</p>
					<a class="cta" href="https://github.com/nicodes/stavlos#readme">
						Open the workshop ↗
					</a>
				</div>
				<div class="workshop-board">
					<div class="board-heading">
						<span>WORKSHOP / ILLUSTRATIVE TEAM</span>
						<span>↗</span>
					</div>
					<div class="channel-heading">
						<span class="channel-badge">#</span>
						<div>
							<small>RESUMABLE CHANNEL</small>
							<b>ship-the-next-thing</b>
						</div>
					</div>
					<div class="agent-lanes">
						<article>
							<span class="agent-badge">A</span>
							<div>
								<b>architect</b>
								<small>Map the system.</small>
							</div>
							<span class="lane-state">→ PLAN</span>
						</article>
						<article>
							<span class="agent-badge">B</span>
							<div>
								<b>builder</b>
								<small>Turn the plan into code.</small>
							</div>
							<span class="lane-state">→ BUILD</span>
						</article>
						<article>
							<span class="agent-badge">R</span>
							<div>
								<b>reviewer</b>
								<small>Check the change.</small>
							</div>
							<span class="lane-state">→ REVIEW</span>
						</article>
					</div>
					<div class="board-inbox">
						<span>ACTOR INBOXES</span>
						<p>Messages and follow-ups reach the agents doing the work.</p>
					</div>
					<div class="board-footer">
						<span>FOLLOW UP</span>
						<span>STEER</span>
						<span>CANCEL</span>
						<span>RESUME</span>
					</div>
				</div>
			</section>
			<section class="team-story" id="team">
				<div class="margin-note">
					<span>01</span>
					<p>
						WORK HAS
						<br />A MEMORY
					</p>
				</div>
				<div>
					<h2 class="section-heading">
						One conversation.
						<br />A whole working team.
					</h2>
					<p class="team-lede">
						Build a team around the job, send work through actor inboxes, and return to resumable channels as the task
						develops.
					</p>
					<div class="team-points">
						<article>
							<h3>Available beyond a turn</h3>
							<p>Agents stay available for follow-up work. Keep the context of a job in its channel.</p>
						</article>
						<article>
							<h3>Steer while it happens</h3>
							<p>Follow up, redirect, cancel a turn or kill an agent. The team can change with the work.</p>
						</article>
					</div>
				</div>
			</section>
			<section class="surfaces">
				<div class="surface-heading">
					<p class="tag">THREE WAYS INTO THE WORKSHOP</p>
					<h2 class="section-heading">
						Work where
						<br />
						the conversation is.
					</h2>
				</div>
				<div class="surface-cards">
					<article>
						<span class="surface-glyph">&gt;_</span>
						<h3>Terminal</h3>
						<p>Stay close to your local workspace. Answer questions and permission requests as work proceeds.</p>
					</article>
					<article>
						<span class="surface-glyph">▣</span>
						<h3>Web</h3>
						<p>
							A loopback browser view for the work, including HTML sheets, questions and permissions. Reply from the
							terminal or Discord.
						</p>
					</article>
					<article>
						<span class="surface-glyph">#</span>
						<h3>Discord</h3>
						<p>Keep the conversation available through a Discord client, with replies back into the work.</p>
					</article>
				</div>
			</section>
			<section class="workshop-start">
				<div>
					<p class="tag">BRING YOUR TOOLS</p>
					<h2 class="section-heading">
						A bench for
						<br />
						the way you work.
					</h2>
					<p>
						Subscription-backed providers include ChatGPT, Grok, Z.ai and Kimi. See the README for current setup and
						requirements.
					</p>
				</div>
				<div class="install-note">
					<span>INSTALL FROM SOURCE</span>
					<pre>git clone https://github.com/nicodes/stavlos.git
cd stavlos
go install ./cmd/stavlos</pre>
					<a href="https://github.com/nicodes/stavlos#readme">Read the setup guide ↗</a>
				</div>
			</section>
		</main>
		<footer class="bottom">
			<span>stavlos / the agent workshop</span>
			<nav aria-label="Footer">
				<a href="https://github.com/nicodes/stavlos">Source</a>
			</nav>
		</footer>
	</div>
</Layout>
<style>
	* {
		box-sizing: border-box;
	}
	a {
		color: inherit;
		text-underline-offset: 5px;
	}
	img {
		max-width: 100%;
	}
	svg {
		max-width: 100%;
	}
	h1,
	h2,
	h3,
	p {
		overflow-wrap: break-word;
	}
	h1,
	h2,
	h3 {
		text-wrap: balance;
	}
	p {
		line-height: 1.7;
	}
	code,
	pre {
		font-family: var(--mono);
	}
	pre {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.folio {
		width: min(1200px, calc(100% - 64px));
		margin: auto;
	}
	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		min-height: 100px;
	}
	.wordmark {
		font-size: 23px;
		font-weight: 750;
		letter-spacing: -0.04em;
		text-decoration: none;
	}
	.topbar nav {
		display: flex;
		gap: 25px;
		align-items: center;
		font-size: 12px;
	}
	.topbar nav a {
		text-decoration: none;
	}
	.tag {
		font: 11px var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 18px 25px;
		font-size: 14px;
		font-weight: 650;
		text-decoration: none;
		border-radius: 4px;
	}
	.bottom {
		padding: 35px 0;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		align-items: center;
		font-size: 12px;
		border-top: 1px solid var(--line);
	}
	.bottom nav {
		display: flex;
		gap: 20px;
	}
	.section-heading {
		font-size: clamp(32px, 4vw, 52px);
		letter-spacing: -0.04em;
		font-weight: 550;
		line-height: 1.1;
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 25px;
	}
	.card-grid h3 {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.card-grid p {
		font-size: 14px;
	}
	.icon svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
	details summary {
		cursor: pointer;
		padding: 20px 0;
		font-size: 16px;
	}
	details {
		border-top: 1px solid var(--line);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}
	th,
	td {
		text-align: left;
		padding: 15px;
		border-bottom: 1px solid var(--line);
		overflow-wrap: anywhere;
	}
	th {
		font-weight: 600;
	}
	main > section {
		margin-bottom: 100px;
	}
	.source-label {
		font: 10px var(--mono);
		letter-spacing: 0.06em;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 5px;
	}
	@media (max-width: 900px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
		main > section {
			margin-bottom: 70px;
		}
	}
	@media (max-width: 600px) {
		.folio {
			width: calc(100% - 36px);
		}
		.topbar {
			min-height: 85px;
			gap: 16px;
			flex-wrap: wrap;
			padding: 20px 0;
		}
		.topbar nav {
			gap: 16px;
			font-size: 11px;
		}
		.wordmark {
			font-size: 21px;
		}
		.bottom {
			flex-wrap: wrap;
		}
		.cta {
			padding: 16px 20px;
		}
		th,
		td {
			padding: 12px 7px;
			font-size: 11px;
		}
		main > section {
			margin-bottom: 55px;
		}
	}
	.workshop-cover {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 75px;
		align-items: center;
		padding-top: 45px;
	}
	.workshop-title h1 {
		font-family: Georgia, serif;
		font-family: Georgia, serif;
		font-size: clamp(54px, 5.5vw, 80px);
		font-weight: 550;
		line-height: 1.05;
		letter-spacing: -0.055em;
		margin: 30px 0;
	}
	.workshop-title h1 em {
		font-family: Georgia, serif;
		font-style: normal;
		font-weight: 400;
		color: #8d492f;
	}
	.workshop-title > p:last-of-type {
		max-width: 440px;
		font-size: 18px;
		color: #746b5c;
	}
	.cta {
		background: #584d35;
		color: #fff;
	}
	.tag {
		color: #8d492f;
	}
	.workshop-board {
		background: #e3dccb;
		border: 1px solid #bdb39a;
		border-radius: 4px;
		padding: 25px;
		box-shadow: 12px 12px 0 #dbd2bd;
		transform: rotate(-1deg);
	}
	.board-heading {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		font: 9px var(--mono);
		color: #786d54;
		padding-bottom: 22px;
		border-bottom: 1px solid #c0b69e;
	}
	.channel-heading {
		display: flex;
		align-items: center;
		gap: 18px;
		padding: 25px 0;
	}
	.channel-badge {
		font:
			32px Georgia,
			serif;
		color: #8d492f;
	}
	.channel-heading small {
		display: block;
		font: 8px var(--mono);
		letter-spacing: 0.1em;
		color: #786d54;
		margin-bottom: 8px;
	}
	.channel-heading b {
		font: 16px var(--mono);
		font-weight: 550;
	}
	.agent-lanes article {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 18px 0;
		border-top: 1px solid #c0b69e;
	}
	.agent-badge {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border: 1px solid #b3a27d;
		border-radius: 50%;
		font:
			17px Georgia,
			serif;
		background: #eee7d6;
	}
	.agent-lanes article:nth-child(2) .agent-badge {
		background: #c4d1b5;
	}
	.agent-lanes article:nth-child(3) .agent-badge {
		background: #d6b89e;
	}
	.agent-lanes b {
		display: block;
		font-size: 14px;
		font-weight: 550;
	}
	.agent-lanes small {
		display: block;
		font-size: 11px;
		color: #786d54;
		margin-top: 6px;
	}
	.lane-state {
		margin-left: auto;
		font: 8px var(--mono);
		color: #786d54;
		white-space: nowrap;
	}
	.board-inbox {
		border: 1px dashed #b8ab8c;
		border-radius: 3px;
		margin-top: 22px;
		padding: 18px;
		background: #eae4d5;
	}
	.board-inbox > span {
		font: 8px var(--mono);
		color: #786d54;
	}
	.board-inbox p {
		font-size: 12px;
		margin: 10px 0 0;
	}
	.board-footer {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
		font: 8px var(--mono);
		color: #786d54;
		padding-top: 22px;
	}
	.team-story {
		display: grid;
		grid-template-columns: 150px 1fr;
		gap: 55px;
		border-top: 1px solid var(--line);
		padding-top: 45px;
	}
	.margin-note {
		font: 10px var(--mono);
		color: #8d492f;
	}
	.margin-note > span {
		font:
			40px Georgia,
			serif;
	}
	.margin-note p {
		font: 10px/1.6 var(--mono);
		letter-spacing: 0.06em;
	}
	.team-lede {
		font-size: 19px;
		color: #746b5c;
		max-width: 680px;
	}
	.team-points {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 45px;
		margin-top: 35px;
	}
	.team-points h3 {
		font-size: 22px;
		font-weight: 550;
	}
	.team-points p {
		font-size: 14px;
		color: #746b5c;
	}
	.surfaces {
		background: #35422f;
		color: #edf0da;
		padding: 45px;
	}
	.surfaces .tag {
		color: #bccba5;
	}
	.surface-heading {
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: 30px;
	}
	.surface-heading h2 {
		margin: 0 0 40px;
	}
	.surface-cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 30px;
	}
	.surface-cards article {
		border-top: 1px solid #6c785c;
		padding-top: 25px;
	}
	.surface-glyph {
		font: 35px var(--mono);
		color: #c7d4ad;
	}
	.surface-cards h3 {
		font-size: 25px;
		font-weight: 550;
	}
	.surface-cards p {
		font-size: 14px;
		color: #c1cbb0;
	}
	.workshop-start {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
	}
	.workshop-start > div > p:last-child {
		font-size: 15px;
		color: #746b5c;
		max-width: 430px;
	}
	.install-note {
		padding: 30px;
		border: 1px solid #c9c1af;
		background: #e4ddce;
		align-self: center;
	}
	.install-note > span {
		font: 10px var(--mono);
		color: #786d54;
	}
	.install-note pre {
		font-size: 12px;
		line-height: 2;
		margin: 25px 0;
	}
	.install-note a {
		font-size: 12px;
	}
	@media (max-width: 900px) {
		.workshop-cover {
			gap: 35px;
		}
		.workshop-board {
			padding: 20px;
		}
		.workshop-title h1 {
			font-family: Georgia, serif;
			font-family: Georgia, serif;
			font-size: 60px;
		}
		.lane-state {
			font-size: 7px;
		}
		.team-story {
			grid-template-columns: 90px 1fr;
			gap: 25px;
		}
		.surface-heading {
			flex-direction: column;
		}
		.surface-cards {
			gap: 22px;
		}
		.workshop-start {
			gap: 35px;
		}
	}
	@media (max-width: 600px) {
		.workshop-cover,
		.workshop-start {
			grid-template-columns: 1fr;
			gap: 35px;
		}
		.workshop-cover {
			padding-top: 20px;
		}
		.workshop-title h1 {
			font-family: Georgia, serif;
			font-family: Georgia, serif;
			font-size: 54px;
		}
		.workshop-title > p:last-of-type {
			font-size: 16px;
		}
		.workshop-board {
			transform: none;
			box-shadow: 6px 6px 0 #dbd2bd;
		}
		.agent-lanes article {
			gap: 12px;
		}
		.channel-heading b {
			font-size: 14px;
		}
		.team-story {
			grid-template-columns: 1fr;
			gap: 15px;
		}
		.margin-note {
			display: flex;
			align-items: center;
			gap: 20px;
		}
		.margin-note > span {
			font-size: 30px;
		}
		.team-points,
		.surface-cards {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		.team-lede {
			font-size: 17px;
		}
		.surfaces {
			padding: 30px 24px;
		}
		.surface-heading h2 {
			margin-bottom: 20px;
		}
		.install-note {
			padding: 25px;
		}
		.install-note pre {
			font-size: 11px;
		}
	}
</style>
