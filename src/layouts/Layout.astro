---
import '../styles/global.css';
const title = 'Stavlos — A workshop for persistent coding agents';
const description = 'A local-first harness for persistent coding-agent teams, with terminal, web and Discord clients. Resume conversations, delegate work, and steer your agents.';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#f3ede2" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta name="twitter:card" content="summary" /><title>{title}</title></head><body><a class="skip-link" href="#main-content">Skip to content</a><slot /></body></html>
